# --- Desarrollo local (Vite) ---
# true (por defecto) = API simulada en el navegador; false = backend real
REACT_APP_USE_MOCK=true
# URL base del backend (Spring Boot) cuando REACT_APP_USE_MOCK=false
REACT_APP_API_URL=http://localhost:8080/api

# --- Despliegue con Docker (docker compose) ---
# URL base del backend que se hornea en el bundle (build-arg VITE_API_URL)
API_URL=http://localhost:8080/api
# Puerto del host para el front
FRONT_PORT=3000
